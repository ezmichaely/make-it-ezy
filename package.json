{
  "name": "make-it-ezy",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first AI capability discovery and orchestration layer",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "ezy": "node apps/cli/dist/index.js",
    "dev:ezy": "pnpm --filter @make-it-ezy/cli exec tsx src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
