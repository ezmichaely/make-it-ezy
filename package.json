{
  "name": "make-it-ezy",
  "private": true,
  "version": "0.1.3",
  "description": "Local-first AI capability discovery and orchestration layer",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r exec tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm test",
    "check:ci": "pnpm check && pnpm audit --prod --audit-level=high",
    "ezy": "node apps/cli/dist/index.js",
    "dev:ezy": "pnpm --filter @make-it-ezy/cli exec tsx src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.10",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.0.9"
  },
  "type": "module"
}
