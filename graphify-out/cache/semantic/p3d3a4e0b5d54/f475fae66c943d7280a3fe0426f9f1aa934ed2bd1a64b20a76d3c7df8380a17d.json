{"nodes": [{"id": "_agents_skills_test_driven_development_writing_good_tests_writing_good_tests", "label": "Writing Good Tests reference", "file_type": "document", "source_file": ".agents/skills/test-driven-development/writing-good-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_test_driven_development_writing_good_tests_name_the_break", "label": "Principle 1: Name the Break", "file_type": "rationale", "source_file": ".agents/skills/test-driven-development/writing-good-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A test earns its place by naming the production change that would make it fail; expectations must be derived independently of the code under test."}, {"id": "_agents_skills_test_driven_development_writing_good_tests_exercise_the_real_thing", "label": "Principle 2: Exercise the Real Thing", "file_type": "rationale", "source_file": ".agents/skills/test-driven-development/writing-good-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mock assertions only prove the mock exists; mock only slow/external levels and keep side effects the test depends on real."}, {"id": "_agents_skills_test_driven_development_writing_good_tests_mutation_check", "label": "The Mutation Check", "file_type": "rationale", "source_file": ".agents/skills/test-driven-development/writing-good-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mentally mutate production code; a mutation no test catches marks unprotected behavior or a tautological test."}, {"id": "_agents_skills_test_driven_development_writing_good_tests_change_detectors", "label": "Change detector tests (anti-pattern)", "file_type": "concept", "source_file": ".agents/skills/test-driven-development/writin